{
  "name": "aloft",
  "private": true,
  "version": "1.3.0",
  "description": "Aloft \u2014 a late young crane, six lands south. A quiet flight.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:sim": "esbuild tests/simcheck.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/simcheck.cjs && node node_modules/.cache/simcheck.cjs",
    "test:journey": "esbuild tests/journey.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/journey.cjs && node node_modules/.cache/journey.cjs",
    "build:single": "vite build --mode single",
    "test:feathers": "esbuild tests/feathers.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/feathers.cjs && node node_modules/.cache/feathers.cjs",
    "build:arcade": "tsc --noEmit && vite build --mode arcade"
  },
  "dependencies": {
    "@fontsource/forum": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "lil-gui": "^0.19.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
